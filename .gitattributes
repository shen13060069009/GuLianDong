# 默认按文本处理，仓库内统一 LF
* text=auto eol=lf

# 二进制资源不做换行转换
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.exe   binary
*.zip   binary
*.db    binary
*.sqlite3 binary
*.nsi   text eol=crlf
*.bat   text eol=crlf

# Python / Web
*.py    text eol=lf
*.js    text eol=lf
*.cjs   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf
*.txt   text eol=lf
